# ─── Supabase ───────────────────────────────────────────────
# Singapore region: https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── API server (backend only — never expose to frontend) ────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3001

# ─── Claude (Anthropic) ─────────────────────────────────────
CLAUDE_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-...

# ─── Internal cron auth ─────────────────────────────────────
INTERNAL_API_KEY=change-me-in-production

# ─── CORS (production: set to your Vercel URL) ───────────────
ALLOWED_ORIGIN=https://your-app.vercel.app

# ─── API URL (web only — leave blank for dev, set for production) ─
# VITE_API_URL=https://your-api.railway.app

# ─── Environment ────────────────────────────────────────────
NODE_ENV=development
