# ─── Supabase ───────────────────────────────────────────────
# Singapore region: https://app.supabase.com → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── API server (backend only — never expose to frontend) ────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
PORT=3001

# ─── Claude (Anthropic) ─────────────────────────────────────
CLAUDE_API_KEY=sk-ant-api03-...
CLAUDE_MODEL=claude-sonnet-4-6

# ─── Telegram ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# ─── Internal cron auth ─────────────────────────────────────
INTERNAL_API_KEY=generate-a-random-secret-here

# ─── CORS (production: set to your Vercel URL) ───────────────
ALLOWED_ORIGIN=https://your-app.vercel.app

# ─── API URL (web only — leave blank for dev, set for production) ─
# VITE_API_URL=https://schoolhub-api.railway.app

# ─── Environment ────────────────────────────────────────────
NODE_ENV=development
